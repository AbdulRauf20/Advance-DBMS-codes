-- TASK 1
-- Trigger Function
CREATE OR REPLACE FUNCTION check_payment_amount()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.amount <= 0 THEN
        RAISE EXCEPTION 'Invalid payment amount: %', NEW.amount;
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


-- Trigger
CREATE TRIGGER payment_amount_check
BEFORE INSERT ON payment
FOR EACH ROW
EXECUTE FUNCTION check_payment_amount();


-- TASK 2 
CREATE TABLE film_price_history (
    film_id INTEGER,
    old_rate NUMERIC(4,2),
    new_rate NUMERIC(4,2),
    changed_at TIMESTAMP
);
CREATE OR REPLACE FUNCTION log_film_price_change()
RETURNS TRIGGER AS $$
BEGIN
    IF OLD.rental_rate IS DISTINCT FROM NEW.rental_rate THEN
        INSERT INTO film_price_history
        (film_id, old_rate, new_rate, changed_at)
        VALUES
        (OLD.film_id, OLD.rental_rate, NEW.rental_rate, CURRENT_TIMESTAMP);
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER film_price_history_trigger
AFTER UPDATE ON film
FOR EACH ROW
EXECUTE FUNCTION log_film_price_change();


---TASK 3 
CREATE OR REPLACE FUNCTION prevent_actor_delete()
RETURNS TRIGGER AS $$
BEGIN
    IF EXISTS (
        SELECT 1
        FROM film_actor
        WHERE actor_id = OLD.actor_id
    ) THEN
        RAISE EXCEPTION 'Cannot delete actor: % %',
            OLD.first_name, OLD.last_name;
    END IF;

    RETURN OLD;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER actor_delete_check
BEFORE DELETE ON actor
FOR EACH ROW
EXECUTE FUNCTION prevent_actor_delete();

---TASK 4 
CREATE OR REPLACE FUNCTION uppercase_customer_email()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.email IS DISTINCT FROM OLD.email THEN
        NEW.email := UPPER(NEW.email);
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER customer_email_uppercase
BEFORE UPDATE ON customer
FOR EACH ROW
EXECUTE FUNCTION uppercase_customer_email();

---TASK 5
CREATE OR REPLACE FUNCTION check_inventory_available()
RETURNS TRIGGER AS $$
BEGIN
    IF EXISTS (
        SELECT 1
        FROM rental
        WHERE inventory_id = NEW.inventory_id
          AND return_date IS NULL
    ) THEN

        RAISE EXCEPTION
            'Inventory ID % is already rented and has not been returned',
            NEW.inventory_id;

    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;


CREATE TRIGGER rental_inventory_check
BEFORE INSERT ON rental
FOR EACH ROW
EXECUTE FUNCTION check_inventory_available();


---TASK 6

CREATE OR REPLACE FUNCTION report_rental_insert_count()
RETURNS TRIGGER AS $$
DECLARE
    inserted_count INTEGER;
BEGIN
    SELECT COUNT(*)
    INTO inserted_count
    FROM new_rentals;

    RAISE NOTICE 'Number of rental rows inserted: %', inserted_count;

    RETURN NULL;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER rental_insert_count
AFTER INSERT ON rental
REFERENCING NEW TABLE AS new_rentals
FOR EACH STATEMENT
EXECUTE FUNCTION report_rental_insert_count();


--TASK 7
CREATE TABLE insufficient_funds_log (
    account_id INTEGER,
    attempted_balance NUMERIC,
    attempted_at TIMESTAMP
);

CREATE OR REPLACE FUNCTION prevent_negative_balance()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.balance < 0 THEN

        INSERT INTO insufficient_funds_log
        (account_id, attempted_balance, attempted_at)
        VALUES
        (NEW.account_id, NEW.balance, CURRENT_TIMESTAMP);

        RAISE EXCEPTION
            'Insufficient funds: account % would have balance %',
            NEW.account_id,
            NEW.balance;
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER account_balance_check
BEFORE UPDATE ON bank_account
FOR EACH ROW
EXECUTE FUNCTION prevent_negative_balance();